{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run API server",
			"type": "shell",
			"command": "uv",
			"args": [
				"run",
				"uvicorn",
				"app.main:app",
				"--reload",
				"--host",
				"127.0.0.1",
				"--port",
				"8000"
			],
			"isBackground": true
		},
		{
			"label": "Run frontend dev server",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"dev",
				"--",
				"--host",
				"127.0.0.1"
			],
			"options": {
				"cwd": "${workspaceFolder}/frontend"
			},
			"isBackground": true
		}
	]
}