VISION_PROVIDER=groq
# Gemini (free tier): VISION_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-4-hydrogen
GEMINI_LOCALIZATION_MODEL=gemini-3.5-flash-lite
# Tried in order when the primary model is overloaded or rate-limited.
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite
# All voice notes (inspections and PDF reports) use Gemini 3.5 Transcribe.
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_REPORT_MODEL=openai/gpt-oss-20b
# Local dev only; Docker pins this to /app/data/inspections.sqlite3.
INSPECTION_DB_PATH=data/inspections.sqlite3

VITE_API_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000
WEB_PORT=3000
